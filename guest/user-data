#cloud-config
# Ubuntu 22.04 guest that hosts the redroid (Android) containers.
# Replace REPLACE_WITH_YOUR_PUBLIC_KEY before building the seed ISO (see SETUP.md).
hostname: android-mc-guest
manage_etc_hosts: true
users:
  - name: lunar
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - REPLACE_WITH_YOUR_PUBLIC_KEY
ssh_pwauth: false
package_update: true
packages:
  - docker.io
  - curl
  - ca-certificates
  - net-tools
  - kmod
write_files:
  - path: /etc/modules-load.d/redroid.conf
    content: |
      binder_linux
runcmd:
  - apt-get install -y "linux-modules-extra-$(uname -r)" || true
  - modprobe binder_linux devices="binder,hwbinder,vndbinder" || true
  - systemctl enable --now docker
  - usermod -aG docker lunar
